'@

    Set-Content `
        -LiteralPath $TypographyPath `
        -Value $TypographyCss `
        -Encoding UTF8

    # --------------------------------------------------------
    # 22. CREATE DASHBOARD ONLY FOR A NEW WORKSPACE
    # --------------------------------------------------------

    if ($CreatedWorkspace) {

        $AppHtmlPath = Join-Path $AppRoot "src\app\app.html"

        if (Test-Path -LiteralPath $AppHtmlPath) {

            $DashboardHtml = @'
