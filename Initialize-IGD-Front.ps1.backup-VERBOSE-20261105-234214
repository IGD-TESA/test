                -LiteralPath $AppHtmlPath `
                -Value $DashboardHtml `
                -Encoding UTF8
        }
    }

    # --------------------------------------------------------
    # 23. CREATE START SCRIPT
    # --------------------------------------------------------

    $StartScriptPath = Join-Path `
        $FrontRoot `
        "scripts\Start-IGD-Front.ps1"

    $StartScriptContent = @'
[CmdletBinding()]
param(
    [string]$HostAddress = "127.0.0.1",
    [int]$Port = 4200
)

Set-StrictMode -Version Latest
$ErrorActionPreference = "Stop"

$InstallRoot = "D:\Program Files\IGD-Frontend"

$NodeExe = Join-Path $InstallRoot `
    "Runtimes\node-v24.15.0-win-x64\node.exe"

$NgJs = Join-Path $InstallRoot `
    "Tools\AngularCLI\node_modules\@angular\cli\bin\ng.js"

$AppRoot = Join-Path (Split-Path -Parent $PSScriptRoot) "app"

$env:TEMP = Join-Path $InstallRoot "PackageCaches\temp"
$env:TMP = $env:TEMP
$env:NPM_CONFIG_CACHE = Join-Path $InstallRoot "PackageCaches\npm"
$env:NPM_CONFIG_REGISTRY = "https://mirror.novin.cloud/artifactory/api/npm/npm/"

if (!(Test-Path -LiteralPath $NodeExe)) {
    throw "Node.js installation was not found."
}

if (!(Test-Path -LiteralPath $NgJs)) {
    throw "Angular CLI installation was not found."
}

Push-Location $AppRoot

try {
    & $NodeExe $NgJs serve --host $HostAddress --port $Port

    if ($LASTEXITCODE -ne 0) {
        throw "Angular development server failed."
    }
}
finally {
    Pop-Location
}
'@

    Set-Content `
        -LiteralPath $StartScriptPath `
        -Value $StartScriptContent `
        -Encoding UTF8

    # --------------------------------------------------------
    # 24. CREATE BUILD SCRIPT
    # --------------------------------------------------------

    $BuildScriptPath = Join-Path `
        $FrontRoot `
        "scripts\Build-IGD-Front.ps1"

    $BuildScriptContent = @'
Set-StrictMode -Version Latest
$ErrorActionPreference = "Stop"

$InstallRoot = "D:\Program Files\IGD-Frontend"

$NodeExe = Join-Path $InstallRoot `
    "Runtimes\node-v24.15.0-win-x64\node.exe"

$NgJs = Join-Path $InstallRoot `
    "Tools\AngularCLI\node_modules\@angular\cli\bin\ng.js"

$AppRoot = Join-Path (Split-Path -Parent $PSScriptRoot) "app"

$env:TEMP = Join-Path $InstallRoot "PackageCaches\temp"
$env:TMP = $env:TEMP
$env:NPM_CONFIG_CACHE = Join-Path $InstallRoot "PackageCaches\npm"
$env:NPM_CONFIG_REGISTRY = "https://mirror.novin.cloud/artifactory/api/npm/npm/"

if (!(Test-Path -LiteralPath $NodeExe)) {
    throw "Node.js installation was not found."
}

if (!(Test-Path -LiteralPath $NgJs)) {
    throw "Angular CLI installation was not found."
}

Push-Location $AppRoot

try {
    & $NodeExe $NgJs build

    if ($LASTEXITCODE -ne 0) {
        throw "Angular production build failed."
    }
}
finally {
    Pop-Location
}
'@

    Set-Content `
        -LiteralPath $BuildScriptPath `
        -Value $BuildScriptContent `
        -Encoding UTF8

    # --------------------------------------------------------
    # 25. INSTALLATION MANIFEST
    # --------------------------------------------------------

    $Manifest = [ordered]@{
        projectRoot = $ProjectRoot
        sourceRoot = $FrontRoot
        angularWorkspace = $AppRoot

        installationRoot = $InstallRoot

        nodeVersion = $InstalledNodeVersion
        npmVersion = $InstalledNpmVersion
        angularCliVersion = $AngularCliVersion

        nodeExecutable = $NodeExe
        npmExecutable = $NpmCli
        angularCli = $AngularCliJs

        projectRuntime = $ProjectRuntime
        dependencyModules = $RuntimeModules

        npmCache = $NpmCache
        temporaryFiles = $TempRoot

        npmRegistry = $NpmRegistry
        nodeMirror = $NodeArchiveUrls[0]

        operatingSystemArchitecture = $env:PROCESSOR_ARCHITECTURE

        createdAt = (Get-Date).ToString("o")

        installationPolicy = (
            "All runtimes, tools, dependencies, caches and downloads " +
            "are stored on drive D. Drive E contains project source " +
            "and project configuration."
        )
    }

    $ManifestPath = Join-Path `
        $FrontRoot `
        "installation-manifest.json"

    $Manifest |
        ConvertTo-Json -Depth 30 |
        Set-Content `
            -LiteralPath $ManifestPath `
            -Encoding UTF8

    # --------------------------------------------------------
    # 26. FINAL PATH VALIDATION
    # --------------------------------------------------------

    $DPaths = @(
        $NodeExe,
        $NpmCli,
        $AngularCliJs,
        $RuntimePackageJson,
        $RuntimeModules,
        $NpmCache,
        $TempRoot
    )

    foreach ($Path in $DPaths) {
        Test-PathOnD $Path

        if (-not (Test-Path -LiteralPath $Path)) {
            Stop-Setup "Installation path validation failed: $Path"
        }
    }

    $NodeModulesLink = Get-Item `
        -LiteralPath $ProjectModules `
        -Force

    if (
        ($NodeModulesLink.Attributes -band
            [IO.FileAttributes]::ReparsePoint) -eq 0
    ) {
        Stop-Setup "Project node_modules is not a junction."
    }

    # --------------------------------------------------------
    # 27. FINAL BUILD
    # --------------------------------------------------------

    if (-not $SkipBuild) {

        Write-Log "Starting production build."

        Invoke-Node `
            -WorkingDirectory $AppRoot `
            -Arguments @(
                $AngularCliJs,
                "build"
            )

        Write-Log "Production build completed." "SUCCESS"
    }
    else {
        Write-Log "Production build skipped." "WARN"
    }

    # --------------------------------------------------------
    # 28. FINAL REPORT
    # --------------------------------------------------------

    Write-Log "============================================" "SUCCESS"
    Write-Log "IGD FRONTEND INITIALIZATION COMPLETED." "SUCCESS"
    Write-Log "============================================" "SUCCESS"

    Write-Log "SOURCE CODE: $FrontRoot" "SUCCESS"
    Write-Log "INSTALLATION: $InstallRoot" "SUCCESS"
    Write-Log "NODE: $NodeRoot" "SUCCESS"
    Write-Log "ANGULAR CLI: $AngularCliRoot" "SUCCESS"
    Write-Log "DEPENDENCIES: $RuntimeModules" "SUCCESS"
    Write-Log "NPM CACHE: $NpmCache" "SUCCESS"
    Write-Log "LOG: $LogFile" "SUCCESS"

}
catch {

    Write-Log "INITIALIZATION FAILED." "ERROR"
    Write-Log $_.Exception.Message "ERROR"

    throw
}
finally {

    if ($TranscriptStarted) {
        try {
            Stop-Transcript | Out-Null
        }
        catch {
            Write-Warning "Transcript could not be closed cleanly."
        }
    }
}